      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="05-cli-dispatch-title" value="&lt;b&gt;provenance-cli: command parse and the two dispatch paths&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1750" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e_cargo" value='&lt;b&gt;cargo-provenance&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;bin/cargo-provenance.rs: accepts&lt;br&gt;only init; runs the sibling&lt;br&gt;provenance __cargo-init&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="255" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_main" value='&lt;b&gt;provenance (main.rs)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;tokio main; on error with JSON&lt;br&gt;output, prints a JSON refusal&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="205" width="255" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e_parse" value='&lt;b&gt;Invocation::parse&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;invocation.rs, grammar.rs.&lt;br&gt;The first word decides:&lt;br&gt;search, api: root words;&lt;br&gt;discussions: addressed form;&lt;br&gt;built-in subcommand name;&lt;br&gt;collection word: catalog;&lt;br&gt;else &amp;lt;ID&amp;gt; &amp;lt;action&amp;gt;: target&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="315" width="255" height="175" as="geometry" />
        </mxCell>
        <mxCell id="hp" value="In-process host path" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f2f7fe;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="310" y="55" width="540" height="410" as="geometry" />
        </mxCell>
        <mxCell id="h_cat" value='&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;provenance &amp;lt;collection&amp;gt; &amp;lt;verb&amp;gt;;&lt;br&gt;catalog_cli::dispatch;&lt;br&gt;skills warning for ideation;&lt;br&gt;statement check execution&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="hp">
          <mxGeometry x="15" y="35" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h_tgt" value='&lt;b&gt;Target&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;provenance &amp;lt;ID&amp;gt; &amp;lt;action&amp;gt;;&lt;br&gt;catalog_cli::dispatch_target;&lt;br&gt;host.target_route&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="hp">
          <mxGeometry x="280" y="35" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h_get" value='&lt;b&gt;Get&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;provenance &amp;lt;ID&amp;gt; get;&lt;br&gt;porcelain::dispatch_get;&lt;br&gt;--review-link: review_link&lt;br&gt;reads the record, then&lt;br&gt;finds the review host&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="hp">
          <mxGeometry x="15" y="165" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h_srch" value='&lt;b&gt;Search, Api, Discussions&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;porcelain dispatch_search,&lt;br&gt;porcelain api;&lt;br&gt;invocation/discussion&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="hp">
          <mxGeometry x="280" y="165" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h_rc" value='&lt;b&gt;RepoContext::local_host()&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;every path above calls it (not get --follow);&lt;br&gt;opens the graph; LocalAccess "native", zero bearer,&lt;br&gt;127.0.0.1:1; StatementHost::with_access&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="hp">
          <mxGeometry x="15" y="300" width="510" height="95" as="geometry" />
