        <mxCell id="t_host" value='&lt;b&gt;provenance-transport StatementHost&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;invoke_resource and porcelain ports,&lt;br&gt;no socket (diagram 04)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
