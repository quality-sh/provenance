        <mxCell id="r_rh" value='&lt;b&gt;Running review host&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;provenance review in another&lt;br&gt;process; WebSocket at&lt;br&gt;/review-events (diagram 07)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
