        <mxCell id="x_pub" value='&lt;b&gt;provenance-store publication&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;with_publication_guard,&lt;br&gt;review_changes snapshot&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1510" y="595" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="note" value="HTTP (http.rs): authenticate (Authorization, then Origin),&lt;br&gt;start the 3 s deadline, take an ingress slot, match the&lt;br&gt;route, refuse an operation that is not advertised, read&lt;br&gt;the body (1 MiB cap), then routing runs the operation&lt;br&gt;on the work pool. MCP takes the same ingress slot.&lt;br&gt;invoke_resource (CLI, api and authoring adapters) takes&lt;br&gt;no ingress slot. The typed porcelain calls skip routing&lt;br&gt;and the work pool." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1195" y="740" width="590" height="140" as="geometry" />
        </mxCell>
