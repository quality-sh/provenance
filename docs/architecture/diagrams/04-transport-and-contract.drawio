        <mxCell id="t_host" value='&lt;b&gt;StatementHost (lib.rs)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;with_access, with_page_writes, with_check_port;&lt;br&gt;router(), invoke_resource(), serve_mcp(), porcelain(), shutdown()&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="tr">
