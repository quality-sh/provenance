        <mxCell id="r1" value='&lt;b&gt;validate&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;parse JSON;&lt;br&gt;envelope.validate;&lt;br&gt;refuse duplicate&lt;br&gt;findings&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rg">
          <mxGeometry x="15" y="35" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r2" value='&lt;b&gt;normalize (order.rs)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;new errors, new warnings,&lt;br&gt;changed intent, resolved,&lt;br&gt;pre-existing, uncertain;&lt;br&gt;then code, subject, site&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rg">
