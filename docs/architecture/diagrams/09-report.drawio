        </mxCell>
        <mxCell id="c_cat" value='&lt;b&gt;catalog.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;stable diagnostic codes;&lt;br&gt;fixed next-action prose;&lt;br&gt;no advice from graph text&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
