        </mxCell>
        <mxCell id="c_render" value='&lt;b&gt;provenance report render&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;--input (envelope JSON),&lt;br&gt;--format markdown or json,&lt;br&gt;--output&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="665" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rp" value="provenance-report (crates/provenance-report/src)" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ecf8f9;strokeColor=#0e8088;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="55" width="720" height="785" as="geometry" />
        </mxCell>
        <mxCell id="bg" value="build_envelope (build/)" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ecf8f9;strokeColor=#0e8088;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="rp">
          <mxGeometry x="15" y="30" width="690" height="515" as="geometry" />
        </mxCell>
        <mxCell id="b1" value='&lt;b&gt;1 resolve the range&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;git::resolve_range: base and head to commits&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="bg">
          <mxGeometry x="15" y="35" width="660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value='&lt;b&gt;2 policy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Settings::load: coverage.binding_findings sets the policy mode&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="bg">
          <mxGeometry x="15" y="110" width="660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value='&lt;b&gt;3 scan&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;scan_path_with_content; Complete only when the scan covers the&lt;br&gt;repository and pins to the head commit&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="bg">
          <mxGeometry x="15" y="185" width="660" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b4" value='&lt;b&gt;4 graph snapshots&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;one git ls-tree probe and one git show per shard file at base and&lt;br&gt;head; diff_snapshots; read_bindings at head&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="bg">
          <mxGeometry x="15" y="270" width="660" height="75" as="geometry" />
        </mxCell>
        <mxCell id="b5" value='&lt;b&gt;5 findings&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;derive_rule_evidence_facts; evidence sites from&lt;br&gt;cache::graph_evidence and stale::gate::report&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="bg">
          <mxGeometry x="15" y="360" width="660" height="75" as="geometry" />
        </mxCell>
        <mxCell id="b6" value='&lt;b&gt;6 ReportEnvelope (envelope.rs)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;scan facts, policy outcome, findings, graph changes; verification_runs empty&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="bg">
          <mxGeometry x="15" y="450" width="660" height="50" as="geometry" />
