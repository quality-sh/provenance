        <mxCell id="d_git" value='&lt;b&gt;Git repository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;commits; shard files at base and head&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
