        <mxCell id="rg" value="render_envelope (pipeline.rs, render/)" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ecf8f9;strokeColor=#0e8088;verticalAlign=top;align=right;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="rp">
          <mxGeometry x="15" y="565" width="690" height="205" as="geometry" />
