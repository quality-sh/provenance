        </mxCell>
        <mxCell id="c_build" value='&lt;b&gt;provenance report build&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;--repo, --base, --head,&lt;br&gt;--repository, --scope,&lt;br&gt;--path (scan path),&lt;br&gt;--output (envelope JSON)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
