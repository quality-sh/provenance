        </mxCell>
        <mxCell id="ts_set" value='&lt;b&gt;settings.ts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PROVENANCE_ENDPOINT, _TOKEN,&lt;br&gt;_REPOSITORY_ID, _LOCAL_ROOT, _SCOPE,&lt;br&gt;_SPEC_OWNER, _VERIFICATION_OWNER;&lt;br&gt;connection(): connectWithBearer&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="ts">
