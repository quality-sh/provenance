        <mxCell id="ts_idx" value='&lt;b&gt;index.ts (.)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;configure; source, requirement, rule,&lt;br&gt;defineSpec (fluent and bound specs);&lt;br&gt;plan, apply; get, search, neighbors,&lt;br&gt;trace, impact, evidence, stale,&lt;br&gt;resolveSymbol&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="ts">
