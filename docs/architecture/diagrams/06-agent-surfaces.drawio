<mxfile host="drawio" type="device" compressed="false">
  <diagram id="06-agent-surfaces" name="Agent surfaces: init guidance, skills, prime, and review not">
    <mxGraphModel dx="1720" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1070" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="06-agent-surfaces-title" value="&lt;b&gt;Agent surfaces: init guidance, skills, prime, and review notices&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a_dev" value='&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;runs provenance init, or&lt;br&gt;create-provenance (diagram 12)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="235" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_guid" value='&lt;b&gt;provenance-porcelain&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;guidance: domain text;&lt;br&gt;also feeds MCP tool&lt;br&gt;discovery (transport)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="235" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a_agent" value='&lt;b&gt;Coding agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;reads the AGENTS.md section&lt;br&gt;and the installed skills;&lt;br&gt;runs provenance commands;&lt;br&gt;receives review notices&lt;br&gt;as data, not instructions&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="360" width="235" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="provenance-cli: agent-facing parts" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f2f7fe;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="290" y="55" width="610" height="505" as="geometry" />
        </mxCell>
        <mxCell id="c_init" value='&lt;b&gt;init (handlers/repo.rs)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;plans every write first:&lt;br&gt;manifest (repository_init),&lt;br&gt;AGENTS.md section, .gitignore,&lt;br&gt;skills, STE dictionary&lt;br&gt;(--ste-pdf); then applies&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="cli">
          <mxGeometry x="15" y="35" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_prime" value='&lt;b&gt;prime&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;prints the guidance text&lt;br&gt;(Markdown or JSON)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="cli">
          <mxGeometry x="15" y="210" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c_warn" value='&lt;b&gt;warn_if_skills_missing&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;catalog commands for questions,&lt;br&gt;contributions, synthesis-packets,&lt;br&gt;proposals&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="cli">
          <mxGeometry x="15" y="295" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c_follow" value='&lt;b&gt;review/follow.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&amp;lt;ID&amp;gt; get --view review&lt;br&gt;--follow --format json:&lt;br&gt;one JSON state frame per change&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="cli">
          <mxGeometry x="15" y="405" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c_onb" value='&lt;b&gt;onboarding.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;"## Provenance" section;&lt;br&gt;command per channel: provenance,&lt;br&gt;or npx, pnpm, yarn, bun, deno, nub;&lt;br&gt;legacy_cleanup removes old text&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="cli">
