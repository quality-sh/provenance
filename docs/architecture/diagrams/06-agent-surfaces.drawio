        <mxCell id="c_sk" value='&lt;b&gt;skills.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;4 SKILL.md files built in&lt;br&gt;(include_str!); list, show,&lt;br&gt;install [--global --copy --force]&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="cli">
