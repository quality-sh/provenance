<mxfile host="drawio" type="device" compressed="false">
  <diagram id="10-ste100" name="provenance-ste100: statement checks and the project STE100 d">
    <mxGraphModel dx="1550" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="10-ste100-title" value="&lt;b&gt;provenance-ste100: statement checks and the project STE100 dictionary&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_check" value='&lt;b&gt;provenance check --statements&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;statements changed from&lt;br&gt;a base or between commits&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_cat" value='&lt;b&gt;POST /statement-checks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;catalog statement.rs; the CLI&lt;br&gt;statement check runs the same&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="180" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_write" value='&lt;b&gt;Requirement and Rule writes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;statement_policy refuses a direct&lt;br&gt;write with violations; typed apply&lt;br&gt;attaches findings to declarations&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_dict" value='&lt;b&gt;provenance dictionary&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;import --pdf, status&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_init" value='&lt;b&gt;provenance init --ste-pdf&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ste_onboarding: the same import&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="495" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="st" value="provenance-store" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fffbee;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="55" width="390" height="545" as="geometry" />
        </mxCell>
        <mxCell id="s_san" value='&lt;b&gt;statement_analysis.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;check_statement: with or&lt;br&gt;without a dictionary;&lt;br&gt;check_project_statement:&lt;br&gt;loads the project dictionary;&lt;br&gt;analyze_changed_statements;&lt;br&gt;StatementDiagnostic: kind,&lt;br&gt;id, field, rule, span&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="st">
          <mxGeometry x="15" y="35" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="s_dref" value='&lt;b&gt;dictionary_reference.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;resolve_project_dictionary:&lt;br&gt;NoReference, Loaded, Unavailable;&lt;br&gt;set_project_dictionary: store the&lt;br&gt;index, write the reference;&lt;br&gt;index_directory&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="st">
          <mxGeometry x="15" y="295" width="360" height="220" as="geometry" />
        </mxCell>
        <mxCell id="ste" value="provenance-ste100" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ecf8f9;strokeColor=#0e8088;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="810" y="55" width="390" height="545" as="geometry" />
        </mxCell>
        <mxCell id="t_chk" value='&lt;b&gt;checks (lib.rs)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;check_descriptive: 8.1 semicolon,&lt;br&gt;4.2 contracted verb, 6.3 sentence&lt;br&gt;over 25 words, 6.6 paragraph over&lt;br&gt;six sentences;&lt;br&gt;with a dictionary: 1.1 word not&lt;br&gt;approved (vocabulary.rs);&lt;br&gt;protected_spans skips quotations&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="ste">
          <mxGeometry x="15" y="35" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="t_dic" value='&lt;b&gt;dictionary/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;import_dictionary: PDF text through&lt;br&gt;pdf_oxide, office_oxide; parse,&lt;br&gt;layout; digest gives the identity;&lt;br&gt;index.rs: store and load the&lt;br&gt;index under a file lock&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="ste">
          <mxGeometry x="15" y="295" width="360" height="220" as="geometry" />
        </mxCell>
        <mxCell id="b_cg" value='&lt;b&gt;provenance-codegen&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;schema feature: JSON Schema&lt;br&gt;of Report (ReportOutput)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1250" y="90" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f_pdf" value='&lt;b&gt;ASD-STE100 Issue 9 PDF&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;supplied by the user;&lt;br&gt;from the ASD request page&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1250" y="360" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f_idx" value='&lt;b&gt;Machine index directory&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PROVENANCE_STE100_INDEX_DIR, or&lt;br&gt;&amp;lt;data dir&amp;gt;/provenance/&lt;br&gt;ste100-dictionary&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1250" y="470" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_ref" value='&lt;b&gt;.provenance/state/dictionary.json&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;tracked: the dictionary identity only&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="385" y="640" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note" value="A missing reference means checks run without&lt;br&gt;Rule 1.1. A reference whose index cannot load&lt;br&gt;is Unavailable: writes go on without it, and&lt;br&gt;a strict check can fail on it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
