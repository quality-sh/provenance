        <mxCell id="x_arch" value='&lt;b&gt;Renderer release archive&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;quality-sh/provenance release&lt;br&gt;renderer-&amp;lt;sha&amp;gt;: provenance-review.tar.gz&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_pin" value='&lt;b&gt;tools/review-assets.json&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;pins commit 13d51d69, CI run,&lt;br&gt;archive sha256, sdkVersion 0.2.3&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rh" value="tools/review-host" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="410" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="b_prep" value='&lt;b&gt;prepare.ts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;HTTPS download; sha256 check;&lt;br&gt;tar -xzf into a work folder&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rh">
          <mxGeometry x="15" y="35" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b_build" value='&lt;b&gt;build.ts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;checks build-info: commit matches&lt;br&gt;the pin, not dirty; copies the&lt;br&gt;renderer; bundles main.ts to&lt;br&gt;host.js (esbuild); adds index.html,&lt;br&gt;host.css, host-build-info.json&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rh">
          <mxGeometry x="15" y="145" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b_gen" value='&lt;b&gt;review-assets-generated/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;in crates/provenance-cli, or&lt;br&gt;PROVENANCE_REVIEW_ASSETS_DIR;&lt;br&gt;else review-assets/index.html&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="740" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rv" value="provenance review (crates/provenance-cli/src/review*)" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f2f7fe;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#1a1a1a;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="55" width="630" height="545" as="geometry" />
        </mxCell>
        <mxCell id="r_run" value='&lt;b&gt;review.rs: run&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;binds 127.0.0.1:&amp;lt;port&amp;gt;; random bearer; LocalAccess;&lt;br&gt;StatementHost with check port and page writes;&lt;br&gt;announces the local-hosts record once it serves;&lt;br&gt;prints {endpoint, bearer, url}; opens /#launch=&amp;lt;code&amp;gt;;&lt;br&gt;--detach, --no-open&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rv">
          <mxGeometry x="15" y="35" width="600" height="115" as="geometry" />
        </mxCell>
        <mxCell id="r_mw" value='&lt;b&gt;protect_origin middleware&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;wraps every route: Host and Origin checks;&lt;br&gt;a valid session cookie supplies the bearer&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rv">
          <mxGeometry x="15" y="170" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r_assets" value='&lt;b&gt;assets::serve&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;fallback route;&lt;br&gt;embedded page files&lt;br&gt;(build.rs)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rv">
          <mxGeometry x="15" y="265" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r_host" value='&lt;b&gt;host.router()&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;catalog routes,&lt;br&gt;GET /metadata&lt;br&gt;(diagram 04)&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rv">
