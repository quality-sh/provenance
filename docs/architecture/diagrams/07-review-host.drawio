        <mxCell id="07-review-host-title" value="&lt;b&gt;Review host: provenance review, the pinned provenance-web renderer, and its clients&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1540" height="30" as="geometry" />
        </mxCell>
        <mxCell id="x_web" value='&lt;b&gt;provenance-web (external repo)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;quality-sh/provenance-web: review&lt;br&gt;renderer; internals not in this repo&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1">
