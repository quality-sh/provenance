        <mxCell id="r_launch" value='&lt;b&gt;launch.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;LaunchKey: one key file per host;&lt;br&gt;LaunchCodes: single-use codes;&lt;br&gt;HttpOnly session cookie&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="rv">
