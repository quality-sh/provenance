        <mxCell id="p_page" value='&lt;b&gt;Review page in the browser&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;index.html, host.js (main.ts, bootstrap.ts,&lt;br&gt;session.ts, events.ts), review.js (renderer)&lt;br&gt;1 take the #launch code from the address&lt;br&gt;2 POST /review-launch/session: bearer, cookie&lt;br&gt;3 GET /review-config&lt;br&gt;4 mountReview (renderer)&lt;br&gt;5 WebSocket /review-events&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="cl">
