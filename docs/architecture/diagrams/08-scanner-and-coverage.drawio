        <mxCell id="s_walk" value='&lt;b&gt;walker.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;scan_path, scan_path_with_content, scan_path_bounded, scan_file;&lt;br&gt;Language from the file extension; ignore.rs skips dependency,&lt;br&gt;build and metadata trees and .gitignore directories;&lt;br&gt;bounded.rs stops at a file count; script_literals masks regex literals&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="sc">
