        </mxCell>
        <mxCell id="s_parse" value='&lt;b&gt;parser.rs, string_context.rs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;comment annotations: "@provenance&lt;br&gt;rule: &amp;lt;id&amp;gt;", coverage, verification&lt;br&gt;keys; legacy @statesman warns;&lt;br&gt;a quoted marker is not a directive&lt;/font&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="sc">
