        <mxCell id="08-scanner-and-coverage-title" value="&lt;b&gt;provenance-scanner: binding scan, rule evidence, and coverage&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
