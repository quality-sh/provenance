{
  "$defs": {
    "NodeType": {
      "enum": [
        "source",
        "requirement",
        "resolution",
        "rule",
        "topic",
        "question",
        "boundary"
      ],
      "type": "string"
    },
    "NotifyClient": {
      "description": "The client that gets review changes: `codex` registers a thread, `off` ends the\nregistration of that thread.",
      "enum": [
        "codex",
        "off"
      ],
      "type": "string"
    },
    "View": {
      "description": "The named view selected for a known record.",
      "enum": [
        "record",
        "children",
        "trace",
        "impact",
        "review"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One semantic known-record request: the target and the get fields.",
  "properties": {
    "depth": {
      "default": null,
      "description": "The number of levels to walk. The default is 1.",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "kind": {
      "default": [],
      "description": "Record kinds to return.",
      "items": {
        "$ref": "#/$defs/NodeType"
      },
      "type": "array"
    },
    "limit": {
      "default": null,
      "description": "The page size. The default is 50.",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "review_link": {
      "default": false,
      "description": "Return a link to this record in the running review host.",
      "type": "boolean"
    },
    "target": {
      "minLength": 1,
      "type": "string"
    },
    "view": {
      "$ref": "#/$defs/View",
      "default": "record"
    }
  },
  "required": [
    "target"
  ],
  "title": "GetInput",
  "type": "object"
}
