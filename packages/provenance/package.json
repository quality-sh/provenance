{
  "name": "@quality-sh/provenance",
  "version": "0.2.2",
  "description": "Typed traceability declarations backed by the Provenance Rust engine",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quality-sh/provenance.git"
  },
  "homepage": "https://github.com/quality-sh/provenance#readme",
  "bugs": "https://github.com/quality-sh/provenance/issues",
  "keywords": [
    "provenance",
    "traceability",
    "slsa",
    "attestation",
    "supply-chain",
    "integrity"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "provenance": "bin/provenance.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js",
      "default": "./dist/rules.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@quality-sh/provenance-darwin-arm64": "0.2.2",
    "@quality-sh/provenance-darwin-x64": "0.2.2",
    "@quality-sh/provenance-linux-x64-gnu": "0.2.2",
    "@quality-sh/provenance-win32-x64-msvc": "0.2.2"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node scripts/generate-release-consumers.js --check && tsc -p tsconfig.json",
    "generate:release-consumers": "node scripts/generate-release-consumers.js",
    "prepack": "npm run build && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "test": "npm run build && npm run test:runtime && npm run test:types && npm run test:packed",
    "test:runtime": "tsc -p tsconfig.test.json && node --test .test-dist/*.test.js scripts/*.test.js",
    "test:types": "node scripts/typecheck-fixtures.mjs",
    "test:bun": "npm run build && bun test test/bun/tail-call.test.ts",
    "test:packed": "node scripts/test-packed-install.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
