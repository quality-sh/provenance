import * as ruleBindings from "@quality-sh/provenance/rules";

// @provenance rule: rule_packed_consumer_overtime
const paysOvertime = (hours: number): boolean => hours > 38;

function overtimeExamples(): void {
  ruleBindings.verifies("rule_packed_consumer_overtime", "examples");
  if (paysOvertime(39) !== true) {
    throw new Error("packed rule bindings changed execution");
  }
}

overtimeExamples();

if (false) {
  // The alias keeps this a type-level check: the scanner reports a literal
  // `verifies(` call with a method word outside its vocabulary.
  const checkMethodWord = ruleBindings.verifies;
  // @ts-expect-error Verification methods use the scanner's fixed vocabulary.
  checkMethodWord("rule_packed_consumer_overtime", "sample");
}
