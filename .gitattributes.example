# Canonical graph state merges record by record, not line by line.
# Each clone must configure the driver once; in an rbac-managed repository the
# literal --actor-id argument carries the merge claim (an attestation, not
# authentication):
#
#   git config merge.provenance-jsonl.name "Provenance canonical JSONL merge"
#   git config merge.provenance-jsonl.driver "provenance merge-jsonl %O %A %B --output %A --path %P --actor-id <ACTOR_ID>"
#
# Without the config git falls back to its usual line merge for these files.
.provenance/state/**/*.jsonl merge=provenance-jsonl
